{
  "Document template": {
    "prefix": "!doc",
    "body": [
      "#import \"@local/ypst-template:0.1.0\" as theme",
      "#import theme: template, sidenote, theorem, lemma, corollary, definition, proof,",
      "  fletcher, diagram, node, edge",
      "",
      "#show: template",
      "",
      "#set document(",
      "  title: \"Title\",",
      "  date: datetime.today(),",
      "  keywords: (\"keyword\",)",
      ")",
      ""
    ]
  },

  "Physica": {
    "prefix": "!physica",
    "body": [
      "#import \"@preview/physica:0.9.8\": (",
      "  dd, dv, pdv, grad, div, curl, laplacian, vb, vu, va,",
      "  imat, dmat, mdet, jmat, hmat, rot2mat, grammat,",
      "  bra, ket, braket, ketbra, expval, mel,",
      "  tensor, hbar, evaluated, Order,",
      ")",
      "$0"
    ]
  },

  "Theorem": {
    "prefix": "!thm",
    "body": [
      "#theorem[",
      "  Theorem.",
      "]"
    ]
  },

  "Lemma": {
    "prefix": "!lem",
    "body": [
      "#lemma[",
      "  Lemma.",
      "]"
    ]
  },

  "Corollary": {
    "prefix": "!cor",
    "body": [
      "#corollary[",
      "  Corollary.",
      "]"
    ]
  },

  "Definition": {
    "prefix": "!def",
    "body": [
      "#definition[",
      "  Definition.",
      "]"
    ]
  },

  "Proof": {
    "prefix": "!proof",
    "body": [
      "#proof[",
      "  Proof.",
      "]"
    ]
  },

  "Sidenote": {
    "prefix": "!side",
    "body": [
      "#sidenote[",
      "  Main text.",
      "][",
      "  Side note.",
      "]"
    ]
  },

  "Sidenote with image": {
    "prefix": "!sideimg",
    "body": [
      "#sidenote(",
      "  side-image: \"image.png\",",
      ")[",
      "  Main text.",
      "][",
      "  Side note.",
      "]"
    ]
  },

  "Numbered equation lines": {
    "prefix": "!eql",
    "body": [
      "#equate-lines[",
      "  $",
      "    a &= b + c #<eq:a> \\",
      "    d &= e + f #<eq:b>",
      "  $",
      "]"
    ]
  },

  "Fletcher diagram": {
    "prefix": "!dia",
    "body": [
      "#diagram(",
      "  node((0, 0), [A]),",
      "  node((1, 0), [B]),",
      "  edge((0, 0), (1, 0)),",
      ")"
    ]
  }
}
